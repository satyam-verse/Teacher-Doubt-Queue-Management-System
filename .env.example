# Application Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=doubtx-ai-super-secret-development-key-change-in-prod
PORT=5000

# JWT Configuration
JWT_SECRET_KEY=doubtx-ai-jwt-secret-key-change-in-prod
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration (MySQL RDS)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
# Fallback to local SQLite for local testing: sqlite:///doubtx_dev.db
DATABASE_URL=sqlite:///doubtx_dev.db
# Production RDS example:
# DATABASE_URL=mysql+pymysql://admin:StrongPassword123@doubtx-db.c1234567890.us-east-1.rds.amazonaws.com:3306/doubtDB

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AWS S3 Configuration (for attachments)
AWS_REGION=us-east-1
AWS_S3_BUCKET=doubtx-attachments-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
